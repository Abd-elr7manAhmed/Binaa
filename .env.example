# Public canonical URL of the deployed Binaa website
BETTER_AUTH_URL=https://your-binaa-domain.vercel.app
# Generate a unique secret (at least 32 random bytes)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Supabase Postgres connection URI (server-side only; never use anon/service keys here)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require
# Google OAuth credentials (optional if using email/password only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be true in production
VITE_AUTH_ENABLED=true
